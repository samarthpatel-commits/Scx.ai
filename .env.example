# Application Environment & Security Controls
ENVIRONMENT=production
DEBUG=false
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://scx-ai-chatbot.onrender.com
APP_AUTH_KEY=your_optional_app_secret_api_key_here

# Database Configuration (Optional external PostgreSQL URL for production)
DATABASE_URL=
DB_FILE=chat_threads.db

# SCX LLM Provider Configuration
SCX_BASE_URL=https://api.scx.ai/v1
SCX_API_KEY=your_scx_api_key_here
SCX_DEFAULT_MODEL=Meta-Llama-3.3-70B-Instruct

# Grounded AI Verification Endpoint & Keys
GROUNDED_ENDPOINT=https://grounded-topaz.vercel.app/api/v1/monitor
GROUNDED_API_KEY=your_grounded_api_key_here
GROUNDED_AGENT_ID=your_grounded_agent_id_here

# Document Storage & Rate Limits
DOCUMENTS_DIR=documents
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=20
